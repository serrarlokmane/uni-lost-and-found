# Copy to .env and fill in yourself. Never commit .env.
# Supabase → Project Settings → API. Use the PUBLISHABLE key only (sb_publishable_...).
# Never put the secret / service_role key here. No NEXT_PUBLIC_ prefix: server only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
